{
  "baseURL": "https://comts224.github.io/my-portfolio/",
  "enableGitInfo": false,
  "themesDir": "themes",
  "timeout": "120s",
  "security": {
    "exec": {
      "allow": [
        "^(dart-)?sass$",
        "^go$",
        "^git$",
        "^node$",
        "^postcss$",
        "^tailwindcss$",
        "^asciidoctor$"
      ]
    },
    "allowContent": [
      "^text/"
    ]
  },
  "theme": [
    "template"
  ],
  "title": "My Portfolio",
  "menus": {
    "main": [
      {
        "name": "Home",
        "pageRef": "/",
        "weight": 10
      },
      {
        "name": "About",
        "pageRef": "/about",
        "weight": 20
      }
    ]
  }
}
