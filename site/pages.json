{
  "baseURL": "https://comts224.github.io/my-portfolio/",
  "enableGitInfo": false,
  "themesDir": "themes",
  "timeout": "120s",
  "security": {
    "exec": {
      "allow": [
        "^(dart-)?sass$",
        "^go$",
        "^git$",
        "^node$",
        "^postcss$",
        "^tailwindcss$",
        "^asciidoctor$"
      ]
    },
    "allowContent": [
      "^text/"
    ]
  },
  "theme": [
    "template"
  ],
  "title": "My Portfolio",
  "outputs": {
    "home": ["HTML", "RSS", "JSON"]
  },
  "menus": {
    "main": [
      {
        "name": "홈",
        "pageRef": "/",
        "weight": 10
      },
      {
        "name": "소개",
        "pageRef": "/about",
        "weight": 20
      },
	{
  	"name": "프로젝트",
 	 "pageRef": "/projects",
 	 "weight": 30
	},
       {
        "name": "데모",
        "url": "https://comts224.github.io/my-portfolio/demo/",
        "weight": 40
       }
    ]
  }
}
